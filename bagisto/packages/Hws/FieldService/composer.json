{
    "name": "hws/field-service",
    "description": "Field service management (tasks, attendance, site surveys, leave, expenses) for Himalayan Water Science, built as a Bagisto package.",
    "type": "bagisto-package",
    "license": "proprietary",
    "authors": [
        {
            "name": "Himalayan Water Science"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Hws\\FieldService\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hws\\FieldService\\Providers\\FieldServiceServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
